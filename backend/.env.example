# ==============================================================================
# FarmOps AI - Backend Environment Configuration Template
# Copy this file to .env and configure with your specific credentials
# ==============================================================================

# Application Settings
PROJECT_NAME="FarmOps AI Backend"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
CORS_ORIGINS='["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]'

# Supabase PostgreSQL Configuration
# Note: For async SQLAlchemy with asyncpg, use postgresql+asyncpg://
DATABASE_URL="postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
# Synchronous DB URL for Alembic migrations if required
DATABASE_DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase Auth Configuration
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# Google Gemini API Configuration (Multi-Agent Orchestration)
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"

# MQTT Broker Configuration (IoT Telemetry Ingestion)
MQTT_BROKER_HOST="broker.hivemq.com"
MQTT_BROKER_PORT=1883
MQTT_USERNAME=""
MQTT_PASSWORD=""
MQTT_ENABLED=False
MQTT_CLIENT_ID="farmops-ai-backend"
MQTT_TOPIC_PREFIX="farmops"

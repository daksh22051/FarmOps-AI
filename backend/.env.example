# ==============================================================================
# FarmOps AI - Backend Environment Configuration Template
# Copy this file to .env and configure with your Supabase credentials
# ==============================================================================

# Application Settings
PROJECT_NAME="FarmOps AI Backend"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
CORS_ORIGINS='["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]'

# Database Configuration (Supabase PostgreSQL via asyncpg)
# Connection pooling port 6543 or session direct 5432:
DATABASE_URL="postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Supabase Auth & Storage Configuration
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
SUPABASE_SECRET_KEY="your-supabase-secret-key"

# AI Multi-Agent Orchestration (Google Gemini API)
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"

# MQTT Broker (IoT Telemetry Ingestion)
MQTT_ENABLED=False
MQTT_BROKER_HOST="broker.hivemq.com"
MQTT_BROKER_PORT=1883
MQTT_USERNAME=""
MQTT_PASSWORD=""
MQTT_CLIENT_ID="farmops-ai-backend"
MQTT_TOPIC_PREFIX="farmops"
